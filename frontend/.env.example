# Adresse der Belegschnittstelle, vom Frontend-Server aus erreichbar.
INVOICEMATCHER_API=http://localhost:8080

# Authentik (portal.tstieh.de) - Werte aus dem OAuth2/OIDC-Provider der Anwendung.
OIDC_ISSUER=https://portal.tstieh.de/application/o/invoicematcher/
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Muss im Provider als Redirect-URI vom Typ "Authorization" eingetragen sein.
OIDC_REDIRECT_URI=http://localhost:4321/auth/callback
# Eigener Eintrag vom Typ "Logout" im selben Provider.
OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:4321/

# Schluessel fuer das Sitzungscookie. Erzeugen mit:
#   openssl rand -base64 32
SESSION_SECRET=

# Gruppe, die ein Konto haben muss. Muss zu invoicematcher.security.required-group passen.
REQUIRED_GROUP=InvoiceMatcher
