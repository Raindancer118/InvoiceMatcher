---
import Grundgeruest from '../layouts/Grundgeruest.astro';
import { api, type Vorgang } from '../lib/api';
import { anzeigezustand, betrag, datum, FORMAT_TEXT, ZUSTAND_KLASSE, ZUSTAND_TEXT } from '../lib/darstellung';

interface Props { alle: Vorgang[]; vorgang?: Vorgang; filter?: string }
const { alle, vorgang, filter = 'alle' } = Astro.props;
const { sitzung } = Astro.locals;
const id = vorgang?.id;
const filterwerte = [['alle', 'Alle'], ['offen', 'Offen'], ['freigegeben', 'Freigegeben'], ['uebergeben', 'Übergeben'], ['abgelehnt', 'Abgelehnt']];
const warteschlange = filter === 'alle' ? alle : alle.filter((v) => anzeigezustand(v) === filter);
const meldung = Astro.url.searchParams.get('meldung');
const zustand = vorgang ? anzeigezustand(vorgang) : null;
const ergebnis = vorgang?.ergebnis;
const quelle = vorgang?.quelle;
const entscheidbar = vorgang?.status === 'OFFEN';
const summe = ergebnis?.buchungszeilen.reduce((s, zeile) => s + zeile.umsatz, 0) ?? 0;
const marke = (schwere: string) => schwere === 'INFO' ? 'm-info' : 'm-warn';
let xml: string | null = null;
let originalFehler: string | null = null;
if (quelle?.format === 'XRECHNUNG' && id) {
  try { xml = await (await api.beleg(sitzung.accessToken, id)).text(); }
  catch { originalFehler = 'Das XML-Original konnte nicht geladen werden. Bitte erneut öffnen.'; }
}
---
<Grundgeruest titel="Prüfliste" benutzer={sitzung.benutzer.name} aktiv="pruefliste" breit>
  {meldung && <p class="meldung" role="status">{meldung}</p>}

  <div class="workbench">
    <aside class="queue" aria-label="Prüfwarteschlange">
      <div class="queue-head"><h1>Auf dem Tisch</h1><span>{alle.length} gesamt</span></div>
      <nav class="queue-filters" aria-label="Warteschlange filtern">
        {filterwerte.map(([wert, text]) => (
          <a href={`/pruefliste?zustand=${wert}`} aria-current={filter === wert ? 'page' : undefined}>{text}</a>
        ))}
      </nav>
      <ul class="queue-list">
        {warteschlange.map((v) => (
          <li><a class="queue-item" href={`/pruefliste?zustand=${filter}&id=${encodeURIComponent(v.id)}`} aria-current={v.id === id ? 'page' : undefined}>
            <strong>{v.quelle.aussteller ?? v.dateiname}</strong>
            <small>{v.ergebnis.belegfeld_1 ?? v.dateiname}</small>
            <span class="queue-meta"><span>{ZUSTAND_TEXT[anzeigezustand(v)]} · {FORMAT_TEXT[v.quelle.format]}</span><span>{betrag(v.quelle.brutto)}</span></span>
          </a></li>
        ))}
      </ul>
    </aside>
    {vorgang && ergebnis && quelle && zustand ? (<div class="detail">
    <div class="belegbild">
      <div class="kopf">
        <span>{vorgang.dateiname}</span>
        <span class="format">{FORMAT_TEXT[quelle.format]}</span>
        <a href={`/vorgang/${vorgang.id}/beleg`} target="_blank" rel="noopener">Original öffnen ↗</a>
      </div>
      {quelle.format === 'XRECHNUNG' ? (
        xml !== null ? <pre class="xml-original" tabindex="0" aria-label="XML-Original">{xml}</pre> : <p class="flaeche">{originalFehler}</p>
      ) : (
        <object data={`/vorgang/${vorgang.id}/beleg`} type="application/pdf" class="pdf" aria-label={`Originalbeleg ${vorgang.dateiname}`}>
          <div class="flaeche">
            Der Beleg lässt sich hier nicht anzeigen.
            <a href={`/vorgang/${vorgang.id}/beleg`} target="_blank" rel="noopener">In neuem Tab öffnen</a>
          </div>
        </object>
      )}
    </div>

    <section class="review" aria-label="Kontierung prüfen">
      <header class="review-header">
        <p class="eyebrow">Vorgang {ergebnis.belegfeld_1 ?? vorgang.dateiname}</p>
        <h2>{quelle.aussteller ?? vorgang.dateiname}</h2>
        <strong class="review-score">{Math.round(ergebnis.konfidenz_score * 100)} %</strong>
  <p class="zustandszeile">
    <span class={'zustand ' + ZUSTAND_KLASSE[zustand]}>{ZUSTAND_TEXT[zustand]}</span>
    {vorgang.entschiedenVon && (
      <span class="klein">durch {vorgang.entschiedenVon} am {datum(vorgang.entschiedenAm)}</span>
    )}
    {vorgang.entscheidungsnotiz && <span class="klein">· {vorgang.entscheidungsnotiz}</span>}
  </p>


      </header>
      {vorgang.hinweise.length > 0 && (
        <div class="karte">
          <h3>Warum dieser Vorgang hier liegt</h3>
          <div class="inhalt">
            {vorgang.hinweise.map((hinweis) => (
              <div class="hinweis">
                <span class={'marke ' + marke(hinweis.severity)}>{hinweis.ruleId}</span>
                <p>{hinweis.message}</p>
              </div>
            ))}
          </div>
        </div>
      )}

      <div class="karte">
        <h3>Belegdaten</h3>
        <div class="inhalt">
          <dl class="kopfdaten">
            <dt>Belegtyp</dt><dd>{ergebnis.document_type}</dd>
            <dt>Belegdatum</dt><dd>{datum(quelle.rechnungsdatum)}</dd>
            <dt>Belegfeld 1</dt><dd class="konto">{ergebnis.belegfeld_1 ?? '—'}</dd>
            <dt>Personenkonto</dt><dd class="konto">{ergebnis.personenkonto ?? '—'}</dd>
            <dt>Aussteller</dt><dd>{quelle.aussteller ?? '—'}</dd>
            <dt>Empfänger</dt><dd>{quelle.empfaenger ?? '—'}</dd>
            <dt>USt-IdNr.</dt><dd class="konto">{quelle.ausstellerUstId ?? '—'}</dd>
            <dt>Netto</dt><dd>{betrag(quelle.netto)}</dd>
            <dt>Steuer</dt><dd>{betrag(quelle.steuer)}</dd>
            <dt>Brutto</dt><dd>{betrag(quelle.brutto)}</dd>
            <dt>Konfidenz</dt><dd>{Math.round(ergebnis.konfidenz_score * 100)} %</dd>
            {ergebnis.buchungstext_kopf && <><dt>Buchungstext</dt><dd>{ergebnis.buchungstext_kopf}</dd></>}
          </dl>
        </div>
      </div>

      <div class="karte">
        <h3>Vorkontierung</h3>
        <div class="inhalt">
          {ergebnis.buchungszeilen.length === 0 ? (
            <p class="klein" style="margin:0">Keine Buchungszeilen.</p>
          ) : (
            <div class="table-scroll"><table class="buchung">
              <thead>
                <tr><th>Sachkonto</th><th>S/H</th><th>Steuerschl.</th><th class="r">Umsatz</th></tr>
              </thead>
              <tbody>
                {ergebnis.buchungszeilen.map((zeile) => (
                  <>
                  <tr>
                    <td class="konto">{zeile.sachkonto}</td>
                    <td>{zeile.soll_haben_kennzeichen}</td>
                    <td>{zeile.steuerschluessel ?? '—'}</td>
                    <td class="r">{betrag(zeile.umsatz)}</td>
                  </tr>
                  {zeile.buchungstext && <tr class="buchungstext"><td colspan="4">{zeile.buchungstext}</td></tr>}
                  </>
                ))}
              </tbody>
              <tfoot>
                <tr><td colspan="3">Summe netto</td><td class="r">{betrag(summe)}</td></tr>
              </tfoot>
            </table></div>
          )}
        </div>
      </div>

      {entscheidbar ? (
        <form class="aktionen" method="post" action={`/vorgang/${vorgang.id}/entscheiden?zustand=${filter}`}>
          <details class="ablehnung">
            <summary>Vorgang ablehnen …</summary>
            <label for="grund">Begründung</label>
            <textarea id="grund" name="grund" rows="3" maxlength="2000" placeholder="Was muss am Beleg geklärt werden?"></textarea>
            <button class="btn btn-ghost" name="entscheidung" value="ablehnen" type="submit">Ablehnung speichern</button>
          </details>
          <span class="klein">
            Konfidenz {ergebnis.konfidenz_score.toFixed(2).replace('.', ',')}
          </span>
          <span class="luecke"></span>
          <button class="btn btn-approve" name="entscheidung" value="freigeben" type="submit">
            Freigeben
          </button>
        </form>
      ) : (
        <p class="aktionen">
          <span class="klein">
            Entschieden. {vorgang.exportiertAm
              ? `An DATEV übergeben am ${datum(vorgang.exportiertAm)}.`
              : 'Noch nicht übergeben.'}
          </span>
        </p>
      )}
    </section>

    {vorgang.gedanken && (
      <details class="gedankenlade">
        <summary aria-label="Gedanken der KI ein- und ausklappen"><span>Gedanken der KI</span></summary>
        <div class="lade-inhalt">
          <h3>Was die KI beim Lesen gedacht hat</h3>
          {vorgang.gedanken.kurzfassung && <p class="gedanken-lead">{vorgang.gedanken.kurzfassung}</p>}
          {vorgang.gedanken.schritte.length > 0 && (
            <ol class="schritte">
              {vorgang.gedanken.schritte.map((schritt) => (
                <li class="schritt">
                  {schritt.titel && <b>{schritt.titel}</b>}
                  <p>{schritt.text}</p>
                </li>
              ))}
            </ol>
          )}
          {vorgang.gedanken.unsicherheiten.length > 0 && (
            <div class="unsicher">
              <b>Woran die KI hängen blieb</b>
              <ul>{vorgang.gedanken.unsicherheiten.map((punkt) => <li>{punkt}</li>)}</ul>
            </div>
          )}
          {vorgang.gedanken.gegenprobe && (
            <p class="gegenprobe"><b>Auch erwogen</b> {vorgang.gedanken.gegenprobe}</p>
          )}
          <p class="gedanken-quelle">{vorgang.gedanken.modell}</p>
        </div>
      </details>
    )}
  </div>) : (
    <section class="workbench-empty"><h2>In diesem Zustand liegt gerade nichts.</h2><p>Wähle einen anderen Filter oder reiche einen Beleg ein.</p><a href="/#datei" data-lade="einreichlade">Beleg einreichen →</a></section>
  )}
  </div>
</Grundgeruest>
