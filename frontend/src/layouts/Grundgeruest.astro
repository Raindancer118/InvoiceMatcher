---
import '../styles/tokens.css';
import Einreichlade from '../components/Einreichlade.astro';

interface Props {
  titel: string;
  /** Name aus dem Konto; fehlt auf Seiten ausserhalb der Anmeldung. */
  benutzer?: string;
  aktiv?: 'uebersicht' | 'pruefliste' | 'export' | 'schluessel' | 'einstellungen';
  breit?: boolean;
}

const { titel, benutzer, aktiv, breit = false } = Astro.props;

const initialen = benutzer
  ? benutzer.split(/\s+/).slice(0, 2).map((teil) => teil[0]?.toUpperCase() ?? '').join('')
  : '';

const navigation = [
  { pfad: '/', name: 'Übersicht', schluessel: 'uebersicht' },
  { pfad: '/pruefliste', name: 'Prüfliste', schluessel: 'pruefliste' },
  { pfad: '/export', name: 'Export', schluessel: 'export' },
  { pfad: '/schluessel', name: 'KI-Schlüssel', schluessel: 'schluessel' },
  { pfad: '/einstellungen', name: 'Einstellungen', schluessel: 'einstellungen' },
] as const;
---
<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{titel} · InvoiceMatcher</title>
  <meta name="robots" content="noindex, nofollow" />
</head>
<body>
  <a class="skip-link" href="#inhalt">Zum Inhalt</a>
  <header class="topbar">
    <a class="wordmark" href="/"><span class="glyph">IM</span>InvoiceMatcher</a>
    {benutzer && (
      <nav class="topnav" aria-label="Hauptnavigation">
        {navigation.map((eintrag) => (
          <a href={eintrag.pfad} aria-current={aktiv === eintrag.schluessel ? 'page' : undefined}>
            {eintrag.name}
          </a>
        ))}
      </nav>
    )}
    {benutzer && (
      <a class="btn btn-primary new-invoice" href="/#datei" data-lade="einreichlade">+ Beleg einreichen</a>
    )}
    {benutzer && (
      <details class="user">
        <summary><span class="avatar">{initialen}</span><span>{benutzer}</span></summary>
        <a class="abmelden" href="/auth/logout">Abmelden</a>
      </details>
    )}
  </header>

  <main id="inhalt" class:list={['wrap', { breit }]} tabindex="-1">
    <slot />
  </main>

  {benutzer && <Einreichlade />}
</body>
</html>
