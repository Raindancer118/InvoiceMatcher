---
import Grundgeruest from '../../layouts/Grundgeruest.astro';
import { api, ApiFehler, type Vorgang } from '../../lib/api';
import {
  anzeigezustand, betrag, datum, FORMAT_TEXT, ZUSTAND_KLASSE, ZUSTAND_TEXT,
} from '../../lib/darstellung';

const { sitzung } = Astro.locals;
const id = Astro.params.id!;

let vorgang: Vorgang;
try {
  vorgang = await api.vorgang(sitzung.accessToken, id);
} catch (fehler) {
  if (fehler instanceof ApiFehler && fehler.status === 404) {
    return new Response('Vorgang unbekannt', { status: 404 });
  }
  throw fehler;
}

const meldung = Astro.url.searchParams.get('meldung');
const zustand = anzeigezustand(vorgang);
const ergebnis = vorgang.ergebnis;
const quelle = vorgang.quelle;
const entscheidbar = vorgang.status === 'OFFEN';

const summe = ergebnis.buchungszeilen.reduce((s, zeile) => s + zeile.umsatz, 0);
const marke = (schwere: string) => (schwere === 'INFO' ? 'm-info' : 'm-warn');
const alle = await api.vorgaenge(sitzung.accessToken, true);
const warteschlange = alle.filter((v) => v.status === 'OFFEN' || v.id === id);
let xml: string | null = null;
let originalFehler: string | null = null;
if (quelle.format === 'XRECHNUNG') {
  try {
    xml = await (await api.beleg(sitzung.accessToken, id)).text();
  } catch {
    originalFehler = 'Das XML-Original konnte nicht geladen werden. Bitte erneut öffnen.';
  }
}
---
<Grundgeruest
  titel={`Vorgang ${ergebnis.belegfeld_1 ?? vorgang.dateiname}`}
  benutzer={sitzung.benutzer.name}
  aktiv="pruefliste"
  breit
>
  <div class="abschnitt">
    <h2>
      {ergebnis.belegfeld_1 ? `Vorgang ${ergebnis.belegfeld_1}` : vorgang.dateiname}
      {quelle.aussteller && <span class="klein"> · {quelle.aussteller}</span>}
    </h2>
    <a href="/pruefliste">← zurück zur Prüfliste</a>
  </div>

  {meldung && <p class="meldung" role="status">{meldung}</p>}

  <p class="zustandszeile">
    <span class={'zustand ' + ZUSTAND_KLASSE[zustand]}>{ZUSTAND_TEXT[zustand]}</span>
    {vorgang.entschiedenVon && (
      <span class="klein">durch {vorgang.entschiedenVon} am {datum(vorgang.entschiedenAm)}</span>
    )}
    {vorgang.entscheidungsnotiz && <span class="klein">· {vorgang.entscheidungsnotiz}</span>}
  </p>

  <div class="workbench">
    <aside class="queue" aria-label="Prüfwarteschlange">
      <p class="eyebrow" style="color:var(--approve)">Prüftisch</p>
      <h2>Als Nächstes</h2>
      <a href="/pruefliste">Alle Vorgänge →</a>
      <ul class="queue-list">
        {warteschlange.map((v) => (
          <li><a class="queue-item" href={`/vorgang/${v.id}`} aria-current={v.id === id ? 'page' : undefined}>
            <strong>{v.quelle.aussteller ?? v.dateiname}</strong>
            <small>{v.ergebnis.belegfeld_1 ?? v.dateiname}</small>
            <span class="queue-meta"><span>{FORMAT_TEXT[v.quelle.format]}</span><span>{betrag(v.quelle.brutto)}</span></span>
          </a></li>
        ))}
      </ul>
    </aside>
    <div class="detail">
    <div class="belegbild">
      <div class="kopf">
        <span>{vorgang.dateiname}</span>
        <span class="format">{FORMAT_TEXT[quelle.format]}</span>
        <a href={`/vorgang/${vorgang.id}/beleg`} target="_blank" rel="noopener">Original öffnen ↗</a>
      </div>
      {quelle.format === 'XRECHNUNG' ? (
        xml !== null ? <pre class="xml-original" tabindex="0" aria-label="XML-Original">{xml}</pre> : <p class="flaeche">{originalFehler}</p>
      ) : (
        <object data={`/vorgang/${vorgang.id}/beleg`} type="application/pdf" class="pdf" aria-label={`Originalbeleg ${vorgang.dateiname}`}>
          <div class="flaeche">
            Der Beleg lässt sich hier nicht anzeigen.
            <a href={`/vorgang/${vorgang.id}/beleg`} target="_blank" rel="noopener">In neuem Tab öffnen</a>
          </div>
        </object>
      )}
    </div>

    <div>
      {vorgang.hinweise.length > 0 && (
        <div class="karte">
          <h3>Warum dieser Vorgang hier liegt</h3>
          <div class="inhalt">
            {vorgang.hinweise.map((hinweis) => (
              <div class="hinweis">
                <span class={'marke ' + marke(hinweis.severity)}>{hinweis.ruleId}</span>
                <p>{hinweis.message}</p>
              </div>
            ))}
          </div>
        </div>
      )}

      <div class="karte">
        <h3>Kopfdaten</h3>
        <div class="inhalt">
          <dl class="kopfdaten">
            <dt>Belegtyp</dt><dd>{ergebnis.document_type}</dd>
            <dt>Belegdatum</dt><dd>{datum(quelle.rechnungsdatum)}</dd>
            <dt>Belegfeld 1</dt><dd class="konto">{ergebnis.belegfeld_1 ?? '—'}</dd>
            <dt>Personenkonto</dt><dd class="konto">{ergebnis.personenkonto ?? '—'}</dd>
            <dt>Aussteller</dt><dd>{quelle.aussteller ?? '—'}</dd>
            <dt>Empfänger</dt><dd>{quelle.empfaenger ?? '—'}</dd>
            <dt>USt-IdNr.</dt><dd class="konto">{quelle.ausstellerUstId ?? '—'}</dd>
            <dt>Netto</dt><dd>{betrag(quelle.netto)}</dd>
            <dt>Steuer</dt><dd>{betrag(quelle.steuer)}</dd>
            <dt>Brutto</dt><dd>{betrag(quelle.brutto)}</dd>
            <dt>Konfidenz</dt><dd>{Math.round(ergebnis.konfidenz_score * 100)} %</dd>
            {ergebnis.buchungstext_kopf && <><dt>Buchungstext</dt><dd>{ergebnis.buchungstext_kopf}</dd></>}
          </dl>
        </div>
      </div>

      <div class="karte">
        <h3>Vorkontierung</h3>
        <div class="inhalt">
          {ergebnis.buchungszeilen.length === 0 ? (
            <p class="klein" style="margin:0">Keine Buchungszeilen.</p>
          ) : (
            <div class="table-scroll"><table class="buchung">
              <thead>
                <tr><th>Sachkonto</th><th>S/H</th><th>Steuerschl.</th><th class="r">Umsatz</th></tr>
              </thead>
              <tbody>
                {ergebnis.buchungszeilen.map((zeile) => (
                  <>
                  <tr>
                    <td class="konto">{zeile.sachkonto}</td>
                    <td>{zeile.soll_haben_kennzeichen}</td>
                    <td>{zeile.steuerschluessel ?? '—'}</td>
                    <td class="r">{betrag(zeile.umsatz)}</td>
                  </tr>
                  {zeile.buchungstext && <tr class="buchungstext"><td colspan="4">{zeile.buchungstext}</td></tr>}
                  </>
                ))}
              </tbody>
              <tfoot>
                <tr><td colspan="3">Summe netto</td><td class="r">{betrag(summe)}</td></tr>
              </tfoot>
            </table></div>
          )}
        </div>
      </div>

      {entscheidbar ? (
        <form class="aktionen" method="post" action={`/vorgang/${vorgang.id}/entscheiden`}>
          <details class="ablehnung">
            <summary>Vorgang ablehnen …</summary>
            <label for="grund">Begründung</label>
            <textarea id="grund" name="grund" rows="3" maxlength="2000" placeholder="Was muss am Beleg geklärt werden?"></textarea>
            <button class="btn btn-ghost" name="entscheidung" value="ablehnen" type="submit">Ablehnung speichern</button>
          </details>
          <span class="klein">
            Konfidenz {ergebnis.konfidenz_score.toFixed(2).replace('.', ',')}
          </span>
          <span class="luecke"></span>
          <button class="btn btn-approve" name="entscheidung" value="freigeben" type="submit">
            Freigeben
          </button>
        </form>
      ) : (
        <p class="aktionen">
          <span class="klein">
            Entschieden. {vorgang.exportiertAm
              ? `An DATEV übergeben am ${datum(vorgang.exportiertAm)}.`
              : 'Noch nicht übergeben.'}
          </span>
        </p>
      )}
    </div>
  </div>
  </div>
</Grundgeruest>

<style is:global>
  .zustandszeile { display: flex; flex-wrap: wrap; align-items: center; gap: .6rem; margin: 0 0 1.2rem; }
  .belegbild .flaeche { flex-direction: column; gap: .6rem; }
  .belegbild .flaeche a { color: var(--accent); }
  .detail .karte:first-child { margin-top: 0; }
</style>
