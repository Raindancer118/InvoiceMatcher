---
import Grundgeruest from '../layouts/Grundgeruest.astro';
import Belegliste from '../components/Belegliste.astro';
import Ablage from '../components/Ablage.astro';
import { api, type Vorgang } from '../lib/api';
import { anzeigezustand, datum, heute, zahlwort } from '../lib/darstellung';

const { sitzung } = Astro.locals;
const alle = await api.vorgaenge(sitzung.accessToken, true);
const mail = await api.mailEingang(sitzung.accessToken).catch(() => null);

const offen = alle.filter((v) => anzeigezustand(v) === 'offen');
const zurUebergabe = alle.filter((v) => anzeigezustand(v) === 'freigegeben');
const uebergeben = alle.filter((v) => anzeigezustand(v) === 'uebergeben');
const abgelehnt = alle.filter((v) => anzeigezustand(v) === 'abgelehnt');

const nachAlter = (a: Vorgang, b: Vorgang) =>
  new Date(a.eingegangenAm).getTime() - new Date(b.eingegangenAm).getTime();

const aeltesteZuerst = [...offen].sort(nachAlter);
const eineWoche = Date.now() - 7 * 24 * 60 * 60 * 1000;
const langeLiegend = offen.filter((v) => new Date(v.eingegangenAm).getTime() < eineWoche).length;
const aeltester = aeltesteZuerst[0];

const vorname = sitzung.benutzer.name.split(/\s+/)[0];
const meldung = Astro.url.searchParams.get('meldung');
---
<Grundgeruest titel="Übersicht" benutzer={sitzung.benutzer.name} aktiv="uebersicht">
  {meldung && <p class="meldung" role="status">{meldung}</p>}
  <div class="hero">
    <div>
      <p class="greeting">Willkommen, <strong>{sitzung.benutzer.name}</strong>. <span>{heute()}</span></p>
      {offen.length === 0 ? (
        <>
          <h1 class="headline">Nichts wartet auf dich, {vorname}.</h1>
          <p class="sub">Alle eingegangenen Belege sind entschieden.</p>
        </>
      ) : (
        <>
          <h1 class="headline">
            <span class="zahl">{zahlwort(offen.length)} {offen.length === 1 ? 'Vorgang' : 'Vorgänge'}</span>
            {offen.length === 1 ? ' wartet auf dich.' : ' warten auf dich.'}
          </h1>
          <p class="sub">
            {langeLiegend > 0 && (
              <>{langeLiegend === 1 ? 'Einer liegt' : `${langeLiegend} davon liegen`} seit über einer Woche. </>
            )}
            {aeltester && <>Der älteste kam am {datum(aeltester.eingegangenAm)} herein.</>}
          </p>
        </>
      )}
    </div>

    <Ablage anker="datei" />
  </div>

  <div class="stats" aria-label="Vorgänge nach Status">
    <a class="stat" href="/pruefliste?zustand=offen"><strong>{offen.length}</strong><span>zur Prüfung</span></a>
    <a class="stat" href="/export"><strong>{zurUebergabe.length}</strong><span>bereit für DATEV</span></a>
    <a class="stat" href="/pruefliste?zustand=uebergeben"><strong>{uebergeben.length}</strong><span>übergeben</span></a>
    <a class="stat" href="/pruefliste?zustand=abgelehnt"><strong>{abgelehnt.length}</strong><span>abgelehnt</span></a>
  </div>

  <div class="overview-grid"><section>
    <div class="abschnitt">
      <h2>Was zuerst</h2>
      <a href="/pruefliste">Alle {alle.length} Vorgänge ansehen →</a>
    </div>
    <Belegliste
      vorgaenge={aeltesteZuerst.slice(0, 3)}
      leerText="Keine offenen Vorgänge."
    />
  </section>
  <aside class="mail-status">
    <h3>{mail ? (mail.aktiv ? 'Mail-Eingang aktiviert' : 'Mail-Eingang pausiert') : 'Mail-Eingang nicht erreichbar'}</h3>
    {mail ? <dl>
      <dt>Postfach</dt><dd>{mail.benutzername || 'Nicht eingerichtet'}</dd>
      <dt>Server</dt><dd>{mail.host || 'Nicht eingerichtet'}</dd>
      <dt>Prüftakt</dt><dd>{mail.taktSekunden} Sekunden</dd>
      <dt>Ordner</dt><dd>{mail.ordner}</dd>
    </dl> : <p>Die Einstellungen konnten nicht geladen werden.</p>}
    <a href="/einstellungen#mail">Mail-Eingang verwalten →</a>
  </aside></div>
</Grundgeruest>
