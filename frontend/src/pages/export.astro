---
import Grundgeruest from '../layouts/Grundgeruest.astro';
import Belegliste from '../components/Belegliste.astro';
import { api } from '../lib/api';
import { betrag, datum } from '../lib/darstellung';

const { sitzung } = Astro.locals;
const offen = await api.exportierbare(sitzung.accessToken);
const uebergeben = (await api.vorgaenge(sitzung.accessToken, true))
  .filter((v) => v.exportiertAm && ['FREIGEGEBEN', 'AUTOMATISCH_FREIGEGEBEN'].includes(v.status));
const meldung = Astro.url.searchParams.get('meldung');
const summe = offen.reduce((s, v) => s + (v.quelle.brutto ?? 0), 0);
---
<Grundgeruest titel="Export" benutzer={sitzung.benutzer.name} aktiv="export">
  {meldung && <p class="meldung" role="status">{meldung}</p>}

  <div class="export-layout"><div>
  <h1>Übergabe an DATEV</h1>
  <p class="sub" style="max-width:65ch">
    Freigegebene Belege, die noch nicht gebucht wurden. Das Paket enthält Belegbild,
    Belegsatzdaten und <code>document.xml</code>. Jeder übergebene Vorgang wird vermerkt und
    wird nur auf ausdrückliche Auswahl erneut exportiert.
  </p>

  {offen.length > 0 && (
    <p class="zahlenzeile">
      <b class="num">{offen.length}</b> {offen.length === 1 ? 'Beleg' : 'Belege'}
      <span class="trenner">·</span>
      <b class="num">{betrag(summe)}</b> brutto
    </p>
  )}

  <h2 class="list-title">Bereit zur Übergabe</h2>
  <Belegliste vorgaenge={offen} leerText="Nichts zur Übergabe bereit." exportListe />
  </div><aside class="export-paket">
    <h2>DATEV-Paket</h2>
    <p>{offen.length} {offen.length === 1 ? 'Beleg' : 'Belege'} · {betrag(summe)} brutto</p>
    <p>Originalbelege und Buchungsdaten in einer ZIP-Datei. Bereits übergebene Belege werden nicht erneut exportiert.</p>
    <form method="post" action="/export/datev" class="datev-form">
      <button class="btn btn-primary" type="submit" disabled={offen.length === 0}>
        Paket erzeugen und herunterladen
      </button>
      <p class="export-status" role="status" hidden></p>
    </form>
  </aside></div>
  <section class="reexport">
    <h2>Erneut exportieren</h2>
    <p>Bereits übergebene Belege gezielt erneut herunterladen. Ein erneuter Import in DATEV kann doppelte Buchungen erzeugen.</p>
    {uebergeben.length === 0 ? <p>Noch keine exportierten Belege vorhanden.</p> : (
      <form method="post" action="/export/datev" class="datev-form">
        <input type="hidden" name="erneut" value="on" />
        <fieldset><legend>Belege für den erneuten Export auswählen</legend>
          {uebergeben.map((v) => <label class="export-auswahl">
            <input type="checkbox" name="vorgaenge" value={v.id} />
            <span><strong>{v.quelle.aussteller ?? v.dateiname}</strong> · {v.ergebnis.belegfeld_1 ?? v.dateiname}<br />
              <small>Erstmals übergeben am {datum(v.exportiertAm)}</small></span>
            <span class="num">{betrag(v.quelle.brutto)}</span>
          </label>)}
        </fieldset>
        <button type="submit" class="btn btn-primary">Ausgewählte Belege erneut exportieren</button>
        <p class="export-status" role="status" hidden></p>
      </form>
    )}
  </section>
</Grundgeruest>

<style>
  .reexport { margin-top:3rem; border-top:1px solid var(--border-strong); padding-top:2rem; }
  fieldset { border:0; margin:1.5rem 0; padding:0; }
  legend { margin-bottom:1rem; }
  .export-auswahl { display:flex; align-items:center; gap:1rem; padding:1rem 0; border-bottom:1px solid var(--border); cursor:pointer; }
  .export-auswahl input { width:20px; height:20px; flex-shrink:0; }
  .export-auswahl .num { margin-left:auto; white-space:nowrap; }
</style>

<script>
  document.querySelectorAll<HTMLFormElement>('.datev-form').forEach((form) => {
  const button = form.querySelector<HTMLButtonElement>('button')!;
  const status = form.querySelector<HTMLParagraphElement>('.export-status')!;
  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (button.disabled) return;
    button.disabled = true;
    status.hidden = false;
    status.textContent = 'Paket wird erstellt …';
    try {
      const body = new URLSearchParams();
      new FormData(form).forEach((value, key) => body.append(key, String(value)));
      const response = await fetch(form.action, { method: 'POST', body });
      if (response.redirected) { window.location.assign(response.url); return; }
      if (!response.ok || !response.headers.get('Content-Type')?.includes('application/zip')) {
        throw new Error('Das Paket konnte nicht heruntergeladen werden. Bitte den Übergabestatus prüfen.');
      }
      const url = URL.createObjectURL(await response.blob());
      const download = document.createElement('a');
      download.href = url;
      download.download = 'DATEV-' + new Date().toISOString().slice(0, 10) + '.zip';
      document.body.append(download);
      download.click();
      download.remove();
      status.textContent = body.has('erneut') ? 'Erneuter Download gestartet. Der ursprüngliche Exportvermerk bleibt erhalten.' : 'Download gestartet. Die enthaltenen Belege wurden als übergeben vermerkt.';
      button.textContent = 'Paket übergeben';
      const refresh = document.createElement('a');
      refresh.href = '/export';
      refresh.textContent = 'Übergabestatus aktualisieren →';
      refresh.style.color = 'var(--approve)';
      status.append(document.createElement('br'), refresh);
      setTimeout(() => URL.revokeObjectURL(url), 60_000);
    } catch (error) {
      status.textContent = error instanceof Error ? error.message : 'Download fehlgeschlagen.';
      button.disabled = false;
    }
  });
  });
</script>
