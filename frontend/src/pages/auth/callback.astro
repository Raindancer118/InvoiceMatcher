---
import { anmeldungAbschliessen } from '../../lib/oidc';
import { anmeldungLesen, anmeldungLoeschen, sitzungSchreiben } from '../../lib/session';

const anmeldung = await anmeldungLesen(Astro.cookies);
anmeldungLoeschen(Astro.cookies);

if (!anmeldung) {
  // Cookie abgelaufen oder der Aufruf kam nicht von uns: von vorn, nicht raten.
  return Astro.redirect('/auth/login');
}

const ergebnis = await anmeldungAbschliessen(Astro.url, anmeldung);
await sitzungSchreiben(Astro.cookies, {
  accessToken: ergebnis.accessToken,
  refreshToken: ergebnis.refreshToken,
  idToken: ergebnis.idToken,
  laeuftAb: ergebnis.laeuftAb,
  benutzer: { name: ergebnis.name, email: ergebnis.email, gruppen: ergebnis.gruppen },
});
return Astro.redirect(anmeldung.ziel);
---
