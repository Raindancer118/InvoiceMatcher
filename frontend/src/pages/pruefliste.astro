---
import Prueftisch from '../components/Prueftisch.astro';
import { api } from '../lib/api';
import { anzeigezustand } from '../lib/darstellung';

const { sitzung } = Astro.locals;
const angefragt = Astro.url.searchParams.get('zustand') ?? 'alle';
const filter = ['alle', 'offen', 'freigegeben', 'uebergeben', 'abgelehnt'].includes(angefragt) ? angefragt : 'alle';
const alle = await api.vorgaenge(sitzung.accessToken, true);
const gezeigt = filter === 'alle' ? alle : alle.filter((v) => anzeigezustand(v) === filter);
const id = Astro.url.searchParams.get('id');
const vorgang = gezeigt.find((v) => v.id === id) ?? gezeigt[0];
---
<Prueftisch alle={alle} vorgang={vorgang} filter={filter} />
